# Copy to .env — never commit real secrets.
ESG_ENVIRONMENT=development
ESG_SECRET_KEY=change-me-in-production
ESG_DATABASE_URL=sqlite:///./backend/esg_nexus.db     # docker-compose overrides with PostgreSQL
ESG_AI_PROVIDER=offline                                # offline | anthropic
ESG_ANTHROPIC_MODEL=claude-opus-5
ESG_ANTHROPIC_EFFORT=high
ANTHROPIC_API_KEY=
ESG_AI_CONFIDENCE_THRESHOLD=0.75
ESG_AUTO_SEED=true
ESG_LOG_LEVEL=INFO
POSTGRES_PASSWORD=esg_dev_password
MINIO_ROOT_USER=esgminio
MINIO_ROOT_PASSWORD=esgminio_dev_password
